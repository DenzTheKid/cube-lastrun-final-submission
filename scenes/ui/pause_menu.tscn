[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://assets/ui/game_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/ui/px_icon_play.png" id="3_iplay"]
[ext_resource type="Texture2D" path="res://assets/ui/px_icon_controls.png" id="4_ictrl"]
[ext_resource type="Texture2D" path="res://assets/ui/px_icon_exit.png" id="5_iexit"]
