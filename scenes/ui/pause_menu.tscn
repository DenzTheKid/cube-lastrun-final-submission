layout_mode = 2
button_pressed = true
text = "SFX:ON"
icon = ExtResource("6_isfx")
alignment = 0

[node name="PauseMusicCheck" type="CheckButton" parent="PausePanel/VBox/AudioRow"]
unique_name_in_owner = true
