[ext_resource type="Texture2D" path="res://assets/ui/px_icon_music_on.png" id="7_imusic"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="PausePanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
texture_filter = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -95.0
offset_top = -85.0
offset_right = 95.0
offset_bottom = 85.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="VBox" type="VBoxContainer" parent="PausePanel"]
layout_mode = 2
theme_override_constants/separation = 7
alignment = 1

[node name="Title" type="Label" parent="PausePanel/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_colors/font_color = Color(0.949, 0.549, 0.22, 1)
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PausePanel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(166, 24)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "RESUME"
icon = ExtResource("3_iplay")
alignment = 0

[node name="RestartButton" type="Button" parent="PausePanel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(166, 23)
layout_mode = 2
text = "RESTART"
icon = ExtResource("4_ictrl")
alignment = 0

[node name="AudioRow" type="HBoxContainer" parent="PausePanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="PauseSfxCheck" type="CheckButton" parent="PausePanel/VBox/AudioRow"]
unique_name_in_owner = true
