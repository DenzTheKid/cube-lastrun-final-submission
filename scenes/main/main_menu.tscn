theme_override_colors/font_outline_color = Color(0.039, 0.043, 0.078, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 9
text = "- Auto-Run: Continuous rightward survival run
- Jump: [SPACE] / [W] / [UP ARROW]
- Aim: [MOUSE] True 360 Continuous Aiming (or Gamepad Right Stick / Arrows)
- Shoot: [LEFT CLICK] / [X] (2-Shell Double-Barrel Shotgun)
- RECOIL JUMP: Shoot DOWNWARD at any angle to launch into the air!
  Spend shells to kill zombies or save shells for jump mobility.
- Reload: [R] (Auto-reloads when dry, 0.8s duration)
- Pause: [ESC] / [P]"

